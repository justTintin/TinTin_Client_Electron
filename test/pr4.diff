+def _bad_sub_boundary(chars, i):
+    """字幕分段禁断边界：英数连续串中间、数字后紧跟量词单位（199|元）。"""
+    a, b = chars[i - 1], chars[i]
+    if _is_ascii_alnum(a) and _is_ascii_alnum(b):
+        return True
+    if a.isdigit() and b in _SUB_UNIT_CHARS:
+        return True
+    return False
