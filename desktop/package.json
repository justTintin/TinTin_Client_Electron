{
  "name": "tintin-client-electron",
  "version": "3.0.0",
  "description": "螺丝钉-电商智能体矩阵 V3 (Electron)",
  "main": "main/main.js",
  "author": "TinTin Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config ./renderer/vite.config.ts",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build --config ./renderer/vite.config.ts",
    "// build 打包说明": "默认打包（build / build:dir）：真实重建原生模块(better-sqlite3/onnxruntime)并打包 ../resources；正式发布用。",
    "// build:no-native 说明": "跳过原生重编译 + 跳过缺失 resources（经 -c builder-skip.json 覆盖 npmRebuild=false、extraResources=[]）；快速跑通流程/无工具链/网络受限时用。注意：其产物原生模块为 Node ABI，运行时可能无法在 Electron 加载，仅作流程验证。",
    "build": "npm run build:renderer && electron-builder --win nsis --x64",
    "build:dir": "npm run build:renderer && electron-builder --win --x64 --dir",
    "build:timestamp": "npm run build:renderer && node scripts/build-timestamp.js",
    "build:no-native": "npm run build:renderer && electron-builder --win nsis --x64 -c builder-skip.json",
    "build:dir:no-native": "npm run build:renderer && electron-builder --win --x64 --dir -c builder-skip.json",
    "contract:gen": "openapi-typescript http://192.168.111.31:8000/openapi.json -o ./renderer/src/types/api-contract.generated.ts",
    "contract:gen-local": "openapi-typescript ../openapi-latest.json -o ./renderer/src/types/api-contract.generated.ts",
    "contract:typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/verify-contract.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"renderer/src/**/*.{ts,vue}\"",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^11.3.0",
    "docx": "^9.7.1",
    "electron-updater": "^6.3.4",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.2",
    "onnxruntime-node": "^1.20.1",
    "openapi-fetch": "^0.17.0",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vitejs/plugin-vue": "^5.0.5",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "openapi-typescript": "^7.13.0",
    "pinia": "^2.1.7",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tintin.electron.v3",
    "productName": "螺丝钉-电商智能体矩阵",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "npmRebuild": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**"
    ],
    "extraResources": [
      {
        "from": "../resources/bin",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      },
      {
        "from": "../resources/icons",
        "to": "icons"
      },
      {
        "from": "../assets/bilibili-helper",
        "to": "assets/bilibili-helper"
      }
    ],
    "files": [
      "main/**/*",
      "preload/**/*",
      "config/**/*",
      "renderer/dist/**/*",
      "!node_modules/**/*",
      "node_modules/adm-zip/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/exceljs/**/*",
      "node_modules/docx/**/*",
      "node_modules/mammoth/**/*",
      "node_modules/{@fast-csv,archiver,archiver-utils,async,balanced-match,base64-js,big-integer,binary,bl,bluebird,brace-expansion,buffer,buffer-crc32,buffer-indexof-polyfill,buffers,chainsaw,compress-commons,crc-32,crc32-stream,dayjs,duplexer2,end-of-stream,fast-csv,fs-constants,fs.realpath,fstream,glob,graceful-fs,ieee754,immediate,inflight,inherits,jszip,lazystream,lie,listenercount,lodash.defaults,lodash.difference,lodash.escaperegexp,lodash.flatten,lodash.groupby,lodash.isboolean,lodash.isequal,lodash.isfunction,lodash.isnil,lodash.isplainobject,lodash.isundefined,lodash.union,lodash.uniq,minimatch,mkdirp,normalize-path,once,pako,path-is-absolute,readable-stream,readdir-glob,rimraf,safe-buffer,saxes,setimmediate,string_decoder,tar-stream,tmp,traverse,undici-types,unzipper,util-deprecate,uuid,wrappy,xmlchars,zip-stream}/**/*",
      "node_modules/{@xmldom/xmldom,argparse,dingbat-to-unicode,duck,hash.js,lop,minimalistic-assert,nanoid,option,underscore,xml,xml-js,xmlbuilder}/**/*"
    ],
    "win": {
      "icon": "../resources/icons/icon.ico"
    }
  }
}
